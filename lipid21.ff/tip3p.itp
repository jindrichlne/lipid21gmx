; TIP3P water (Jorgensen et al. 1983) as used by Amber
; converted from $AMBERHOME/dat/leap/parm/{frcmod.tip3p,frcmod.ions1lm_126_tip3p,frcmod.ionsjc_tip3p,frcmod.ions234lm_126_tip3p} (load order of leaprc.water.tip3p)
; Rigid geometry as in Amber (SETTLE on O-H 0.9572 A and H-H 1.5136 A, i.e. HOH 104.49 deg);
; note that the TIP3P files shipped with GROMACS use H-H 1.5139 A.
; With -DFLEXIBLE: O-H bonds as in frcmod.tip3p and HOH angle 104.52 deg, 100 kcal/mol/rad^2.

[ moleculetype ]
; molname  nrexcl
SOL        2

[ atoms ]
;  id  at type    res nr  res name  at name  cg nr  charge     mass
    1  OW_tip3p   1       SOL       OW       1      -0.834000  16.0
    2  HW_tip3p   1       SOL       HW1      1       0.417000  1.008
    3  HW_tip3p   1       SOL       HW2      1       0.417000  1.008

#ifndef FLEXIBLE

[ settles ]
; OW  funct  doh      dhh
  1   1      0.09572  0.15136

[ exclusions ]
1  2  3
2  1  3
3  1  2

#else

[ bonds ]
; i  j  funct  length   force_constant
  1  2  1      0.09572  462750.4
  1  3  1      0.09572  462750.4

[ angles ]
; i  j  k  funct  angle   force_constant
  2  1  3  1      104.52  836.8

#endif
