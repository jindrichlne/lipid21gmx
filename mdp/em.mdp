; Energy minimisation of a Lipid21 membrane system
integrator              = steep
nsteps                  = 5000
emtol                   = 500.0
cutoff-scheme           = Verlet
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = no
